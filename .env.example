# TRACER environment configuration — COPY to .env and fill in.
# All values are DUMMY / safe defaults. Never commit a real .env.

# --- Runtime mode ---------------------------------------------------------
# "production" enforces secret-length rules and disables /docs + /openapi.json.
ENVIRONMENT=development
# Set to false to hide Swagger /docs and /openapi.json (prod default).
DOCS_ENABLED=true

# --- Network / CORS -------------------------------------------------------
# Comma-separated explicit origins. NO wildcard "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional infrastructure (graceful degrade if unset/unreachable) -------
# Idempotency + feature-store cache. Falls back to in-process TTL store.
REDIS_URL=redis://localhost:6379/0
# Async, non-blocking graph mirror. Falls back to NetworkX-only.
NEO4J_URI=bolt://localhost:7687

# --- LLM dispute dossiers (optional; bounded agent still works without) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Razorpay webhook security -------------------------------------------
# MUST be >= 32 chars when ENVIRONMENT=production (raises ConfigError otherwise).
RAZORPAY_WEBHOOK_SECRET=dev-only-insecure-secret-please-rotate-32ch
# If 1, webhooks with an invalid/missing signature are rejected with 403.
REQUIRE_WEBHOOK_SECRET=0

# --- Tuning ---------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=600

# --- Frontend (Next.js public runtime var) -------------------------------
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
